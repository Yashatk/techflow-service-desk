# Copie para .env e preencha. O .env NAO e versionado.
DB_URL="jdbc:sqlserver://localhost:1433;databaseName=techflow;encrypt=true;trustServerCertificate=true"
DB_USERNAME=sa
# SQL Server exige senha forte: 8+ caracteres com maiúscula, minúscula, número e símbolo
DB_PASSWORD=
# Obrigatorio: minimo 32 caracteres aleatorios (ex.: openssl rand -base64 48)
JWT_SECRET=
# Opcional: cria o usuario 'admin' no primeiro boot
ADMIN_DEFAULT_PASSWORD=
# Opcional: origens liberadas no CORS, separadas por virgula (o front embutido nao precisa)
CORS_ALLOWED_ORIGINS=http://localhost:8089
# Opcional: fuso usado nos filtros de data
APP_TIMEZONE=America/Sao_Paulo
